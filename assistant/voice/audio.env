# Phone audio settings, one source for listen.sh, assistant.sh (sourced) and the MCP tools
# speak/listen in assistant/mcp/server.py (parsed: KEY=VALUE or KEY="VALUE" lines only).
PULSE_SERVER=127.0.0.1
PULSE_COOKIE=/root/phone/pa/cookie
AUDIODRIVER=pulseaudio
# rec effect after the file name: start on sound above 2 %, stop after 1.3 s below 2 %.
VA_REC_SILENCE="silence 1 0.1 2% 1 1.3 2%"
# Start-of-recording beep: seconds, Hz, volume (SoX synth sine).
VA_BEEP="0.12 880 0.35"
